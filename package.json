{
  "name": "persian-holidays",
  "version": "1.5.1",
  "description": "A unified calendar events engine for Persian, Islamic, and international dates, providing bilingual event data(English & Persian), holiday classification, and a powerful query system for fixed and relative events.",
  "type": "module",
  "keywords": [
    "persian",
    "jalali",
    "hijri",
    "gregorian",
    "holidays",
    "events",
    "iran",
    "calendar"
  ],
  "license": "MIT",
  "author": {
    "name": "Alireza Mohammadzadeh(NedaMani)",
    "url": "https://nedamani.ir"
  },
  "homepage": "https://github.com/karfekr/persian-holidays",
  "bugs": {
    "url": "https://github.com/karfekr/persian-holidays/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karfekr/persian-holidays.git"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./gregorian": {
      "types": {
        "import": "./dist/gregorian.d.ts",
        "require": "./dist/gregorian.d.cts"
      },
      "import": "./dist/gregorian.js",
      "require": "./dist/gregorian.cjs"
    },
    "./hijri": {
      "types": {
        "import": "./dist/hijri.d.ts",
        "require": "./dist/hijri.d.cts"
      },
      "import": "./dist/hijri.js",
      "require": "./dist/hijri.cjs"
    },
    "./jalali": {
      "types": {
        "import": "./dist/jalali.d.ts",
        "require": "./dist/jalali.d.cts"
      },
      "import": "./dist/jalali.js",
      "require": "./dist/jalali.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "README_FA.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build:json": "node scripts/build-json.mjs",
    "build": "pnpm run build:json && tsup",
    "test": "vitest",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@internationalized/date": "^3.12.2",
    "glob": "^13.0.6",
    "js-yaml": "^5.2.1",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "simple-git-hooks": "^2.13.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint",
    "commit-msg": "commitlint --edit $1",
    "pre-push": "pnpm run build && pnpm run test"
  }
}
